# --- Database (required)
# On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@host:5432/railway
# Set to true only if your Postgres requires SSL (Railway's does not).
DATABASE_SSL=false

# --- Optional
# Name shown in the logo pill.
APP_NAME=CAD2BIM
# Set a password to put the whole dashboard behind a simple browser login prompt.
BASIC_AUTH_PASSWORD=
BASIC_AUTH_USER=admin

# Local development only (Railway sets PORT itself).
PORT=8080
