# --- Database (required)
# On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@host:5432/railway
# Set to true only if your Postgres requires SSL (Railway's does not).
DATABASE_SSL=false

# --- Sign-in accounts (required to sign in)
# "admin" can change everything; "viewer" can look but not edit.
# An account is only enabled once its password is set. Use long random passwords.
TRACKER_ADMIN_USERNAME=admin
TRACKER_ADMIN_PASSWORD=
TRACKER_VIEWER_USERNAME=viewer
TRACKER_VIEWER_PASSWORD=
# Optional extra secret for signing session cookies (any long random string).
TRACKER_SESSION_SECRET=

# --- Optional
# Name shown next to the logo.
APP_NAME=CAD2BIM
# Set a password to put the whole dashboard behind a simple browser login prompt.
BASIC_AUTH_PASSWORD=
BASIC_AUTH_USER=admin

# Local development only (Railway sets PORT itself).
PORT=8080
